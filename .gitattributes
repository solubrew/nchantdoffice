# Git attributes for nchantdoffice

# Binary files
*.pyc binary
*.so binary
*.dylib binary

# Text files with specific encodings
*.py encoding=utf-8
*.md encoding=utf-8
*.yaml encoding=utf-8
*.yml encoding=utf-8
*.json encoding=utf-8
*.toml encoding=utf-8

# Large files - use Git LFS
# *.pdf binary filter=lfs diff=lfs merge=lfs -text
# *.png binary filter=lfs diff=lfs merge=lfs -text
# *.jpg binary filter=lfs diff=lfs merge=lfs -text
