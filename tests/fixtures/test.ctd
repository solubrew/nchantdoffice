DIM a(25),b(25) 
FOR i=1 to m 
   LET a(i)=cos(2*pi*i/m) 
   LET b(i)=sin(2*pi*i/m) 
NEXT i 
PRINT "GENERAL twon dragon I.F.S. " 
PRINT "BY R.L.BAGULA 19 April 1998(C) copy rights reserved" 
RANDOMIZE 
LET r=sqr(1.25*m) 
PRINT " M=";m 
FOR n= 1 TO 2000000 
   LET c =RND 
   LET d=int(c*m) 
   let ra=(sqr(3*(x*x+y*y))) 
   LET x1=-x/(r )+y/(r*ra )+a(1+d) 
   LET y1=-x/(r*ra )-y/(r )+b(1+d) 
   LET x=x1 
   LET y=y1 
   SET COLOR 256-mod((m-1)*c,m) 
   IF n&gt;10 THEN PLOT 1026/2+s1*x,750/2+s2*y 
NEXT n 
END

