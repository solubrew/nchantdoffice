</rich_text>
      <node unique_id="1616" master_id="0" name="Bohm Dialogue" prog_lang="custom-colors" tags="" readonly="0" nosearch_me="0" nosearch_ch="0" custom_icon_id="0" is_bold="0" foreground="" ts_creation="0" ts_lastsave="0">
