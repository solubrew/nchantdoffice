PI * i / (double)m);
		b[i] = sin(2 

PI * i / (double)m);
	}
	
	r = sqrt(1.25 

m);
	for (n=0;n&lt;N;n++) {
		if ((n % (N/100)) == 0)
			fprintf(stderr,"%d\n",n);
		c = rand() % m;
		ra = sqrt(3.0 

(x*x + y*y));
		x1 = - x / r + y / (ra 

r) + a[c];
		y1 = - x / (ra 

r) - y / r + b[c];
		x = x1;
		y = y1;
		if (n &lt; 100)
			continue;
		ix = x 

SCALE + NX/2;
		iy = y 

SCALE + NY/2;
      DrawPixel(image,NX,NY,ix,iy,black);
	}

	/

Write the image to a ppm file */
	sprintf(fname,"roger15_%d.tiff",m);
	if ((fptr = fopen(fname,"w")) == NULL) {
		fprintf(stderr,"Unable to open bitmap file\n");
		exit(0);
	}
	WriteBitmap(fptr,image,NX,NY,5);
	fclose(fptr);
