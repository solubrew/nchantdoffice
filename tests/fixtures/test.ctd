              <node unique_id="718" master_id="0" name="1902 AD" prog_lang="custom-colors" tags="" readonly="0" nosearch_me="0" nosearch_ch="0" custom_icon_id="0" is_bold="0" foreground="" ts_creation="0" ts_lastsave="0">
                <rich_text>1902 	

    * Willis Carrier invents the air conditioner.
